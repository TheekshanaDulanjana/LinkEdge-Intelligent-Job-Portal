generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ────────────────────────────────────────────────

model User {
  id                    String           @id @default(uuid())
  email                 String           @unique
  passwordHash          String?          // Nullable — Google users have no password
  role                  Role             @default(SEEKER)
  isEmailVerified       Boolean          @default(false)
  googleId              String?          @unique
  authProvider          AuthProvider     @default(LOCAL)
  verificationCode      String?
  verificationExpiresAt DateTime?
  resetToken            String?
  resetTokenExpiresAt   DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  seeker                JobSeeker?
  company               Company?
  sentNotifications     Notification[]   @relation("NotificationSender")
  receivedNotifications Notification[]   @relation("NotificationReceiver")
  resume                CandidateResume? // NEW — one-to-one optional
}

model JobSeeker {
  id                  String     @id @default(uuid())
  userId              String     @unique
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName            String
  phone               String?
  location            String?
  profileImageUrl     String?
  interestArea        String?
  workStatus          WorkStatus @default(UNEMPLOYED)
  professionalSummary String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Company {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  industry      String?
  website       String?
  location      String?
  phone         String?
  logoUrl       String?
  coverImageUrl String?
  aboutUs       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Jobs ───────────────────────────────────────────────────────

model JobPosting {
  id           String        @id @default(uuid())
  companyId    String
  title        String
  description  String
  requirements String
  location     String
  jobType      JobType       @default(FULL_TIME)
  salaryMin    Int?
  salaryMax    Int?
  deadline     DateTime
  status       JobStatus     @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

// ─── Applications ───────────────────────────────────────────────

model Application {
  id                String            @id @default(uuid())
  jobId             String
  seekerId          String
  cvUrl             String
  cvTextSnapshot    String?
  coverLetter       String?
  status            ApplicationStatus @default(PENDING)
  rejectionReason   String?
  rejectionMessage  String?
  interviewDate     DateTime?
  interviewTime     String?
  interviewVenue    String?
  practiceExpiresAt DateTime?
  aiScore           Float?
  atsScore          Float?            // NEW — cached score at time of application
  atsBreakdown      Json?             // NEW — score breakdown snapshot
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  job               JobPosting        @relation(fields: [jobId], references: [id])
}

// ─── Resume & ATS ───────────────────────────────────────────────

model CandidateResume {
  id              String     @id @default(uuid())
  candidateId     String     @unique
  filePath        String
  originalName    String
  fileSize        Int
  mimeType        String
  uploadedDate    DateTime   @default(now())
  parsedText      String?
  skills          String[]   @default([])
  experienceYears Float?
  experience      Json?      // [{title, company, duration, description}]
  education       Json?      // [{degree, institution, year}]
  certifications  String[]   @default([])
  technologies    String[]   @default([])
  jobTitle        String?    // detected current/target title
  lastUpdated     DateTime   @updatedAt
  isParsed        Boolean    @default(false)
  parseError      String?
  atsScores       ATSScore[]
  user            User       @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model ATSScore {
  id                 String          @id @default(uuid())
  resumeId           String
  jobId              String
  overallScore       Float           // 0-100
  technicalScore     Float
  experienceScore    Float
  educationScore     Float
  certificationScore Float
  keywordScore       Float
  matchedSkills      String[]        @default([])
  missingSkills      String[]        @default([])
  breakdown          Json            // detailed score explanation
  calculatedAt       DateTime        @default(now())
  resume             CandidateResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, jobId])
  @@index([jobId])
  @@index([resumeId])
}

// ─── Notifications ──────────────────────────────────────────────

model Notification {
  id         String           @id @default(uuid())
  senderId   String?
  receiverId String
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  metadata   Json?
  createdAt  DateTime         @default(now())
  sender     User?            @relation("NotificationSender", fields: [senderId], references: [id])
  receiver   User             @relation("NotificationReceiver", fields: [receiverId], references: [id])
}

// ─── Enums ──────────────────────────────────────────────────────

enum Role {
  SEEKER
  COMPANY
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum WorkStatus {
  EMPLOYED
  UNEMPLOYED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  ACTIVE
  INACTIVE
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW
  REJECTED
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_SHORTLISTED
  INTERVIEW_SCHEDULED
  APPLICATION_REJECTED
  STATUS_UPDATE
  SYSTEM
}