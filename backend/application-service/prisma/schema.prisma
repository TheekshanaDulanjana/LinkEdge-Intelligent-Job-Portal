generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                         String         @id @default(uuid())
  email                                      String         @unique
  passwordHash                               String?
  role                                       Role           @default(SEEKER)
  createdAt                                  DateTime       @default(now())
  updatedAt                                  DateTime       @updatedAt
  authProvider                               AuthProvider   @default(LOCAL)
  googleId                                   String?        @unique
  isEmailVerified                            Boolean        @default(false)
  resetToken                                 String?
  resetTokenExpiresAt                        DateTime?
  verificationCode                           String?
  verificationExpiresAt                      DateTime?
  company                                    Company?
  seeker                                     JobSeeker?
  Notification_Notification_receiverIdToUser Notification[] @relation("Notification_receiverIdToUser")
  Notification_Notification_senderIdToUser   Notification[] @relation("Notification_senderIdToUser")
}

model JobSeeker {
  id                  String     @id @default(uuid())
  userId              String     @unique
  fullName            String
  phone               String?
  location            String?
  createdAt           DateTime   @default(now())
  interestArea        String?
  professionalSummary String?
  profileImageUrl     String?
  updatedAt           DateTime
  workStatus          WorkStatus @default(UNEMPLOYED)
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id                                 String           @id @default(uuid())
  senderId                           String?
  receiverId                         String
  type                               NotificationType
  title                              String
  message                            String
  isRead                             Boolean          @default(false)
  metadata                           Json?
  createdAt                          DateTime         @default(now())
  User_Notification_receiverIdToUser User             @relation("Notification_receiverIdToUser", fields: [receiverId], references: [id])
  User_Notification_senderIdToUser   User?            @relation("Notification_senderIdToUser", fields: [senderId], references: [id])
}

model Company {
  id            String   @id @default(uuid())
  userId        String   @unique
  companyName   String
  industry      String?
  website       String?
  createdAt     DateTime @default(now())
  aboutUs       String?
  coverImageUrl String?
  location      String?
  logoUrl       String?
  phone         String?
  updatedAt     DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id           String        @id @default(uuid())
  companyId    String
  title        String
  description  String
  requirements String
  location     String
  jobType      JobType       @default(FULL_TIME)
  salaryMin    Int?
  salaryMax    Int?
  deadline     DateTime
  status       JobStatus     @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Application {
  id                String            @id @default(uuid())
  jobId             String
  seekerId          String
  cvUrl             String
  cvTextSnapshot  String? 
  coverLetter       String?
  status            ApplicationStatus @default(PENDING)
  aiScore           Float?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  interviewDate     DateTime?
  interviewTime     String?
  interviewVenue    String?
  practiceExpiresAt DateTime?
  rejectionMessage  String?
  rejectionReason   String?
  job               JobPosting        @relation(fields: [jobId], references: [id])
}

enum Role {
  SEEKER
  COMPANY
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
  INACTIVE
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  INTERVIEW
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_SHORTLISTED
  INTERVIEW_SCHEDULED
  APPLICATION_REJECTED
  STATUS_UPDATE
  SYSTEM
}

enum WorkStatus {
  EMPLOYED
  UNEMPLOYED
}
