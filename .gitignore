# Environment files — NEVER commit these
.env
.env.local
.env.production
.env.*.local
**/.env
**/.env.*

# Dependencies
node_modules/
**/node_modules/

# Python
**/__pycache__/
**/*.pyc
**/venv/
**/.venv/

# Build outputs
**/dist/
**/.next/

# Uploaded files — these are user data, not code
**/uploads/*.pdf
**/uploads/*.doc
**/uploads/*.docx

# Logs
*.log
**/logs/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/