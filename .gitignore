# ============================================================================
# ENVIRONMENT FILES - DO NOT COMMIT
# ============================================================================
# Place .env files in the following locations (one file per service):
#   - backend/auth-service/.env
#   - backend/application-service/.env
#   - backend/ai-service/.env
#   - backend/interview-service/.env
#   - backend/job-service/.env
#   - frontend/.env.local
#   - frontend/.env.local.example (can be committed as template)
# ============================================================================

# Environment variables
.env
.env.local
.env.*.local
.env.production.local

# ============================================================================
# NODE.JS & NPM
# ============================================================================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ============================================================================
# RUNTIME & BUILD ARTIFACTS
# ============================================================================
dist/
build/
.next/
.out/
.cache/
.turbo/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ============================================================================
# LOGS
# ============================================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ============================================================================
# IDE & EDITOR
# ============================================================================
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ============================================================================
